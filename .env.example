# ---- Shared ----
NODE_ENV=development

# ---- Postgres ----
POSTGRES_USER=pulseai
POSTGRES_PASSWORD=changeme
POSTGRES_DB=pulseai
DATABASE_URL=postgresql://pulseai:changeme@postgres:5432/pulseai

# ---- Redis ----
REDIS_URL=redis://redis:6379

# ---- Backend ----
BACKEND_PORT=4000
JWT_SECRET=changeme-generate-a-real-secret
RECOMMENDATION_ENGINE_URL=http://recommendation-engine:8000

# ---- Frontend ----
# Server-side only (used by next.config.js's rewrite proxy, never sent to
# the browser). "http://localhost:4000" for native/local dev,
# "http://backend:4000" when running via docker-compose.
BACKEND_INTERNAL_URL=http://localhost:4000

# ---- Recommendation engine ----
RECO_PORT=8000
NEWSAPI_KEY=your_newsapi_key_here
ALPHA_VANTAGE_KEY=your_alpha_vantage_key_here
# yfinance needs no key

DATABASE_URL_PYTHON=postgresql://pulseai:changeme@postgres:5432/pulseai
